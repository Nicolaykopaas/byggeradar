# Kopier denne til .env og fyll inn dine egne verdier. .env spores IKKE av git.
# Alt er valgfritt - pipelinen kjører uten. Fyll inn det du trenger, når du trenger det.

# --- Stripe (SALG) ---------------------------------------------------------
# Enten: lim inn din hemmelige nøkkel så stripe_setup.py lager betalingslenken
STRIPE_SECRET_KEY=sk_live_xxx
# Eller: lag lenken selv i Stripe-dashbordet og lim den inn her (da trengs ikke nøkkel)
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx

# --- Landingsside ----------------------------------------------------------
# URL-en der du har lastet opp landing/index.html (GitHub Pages, Netlify e.l.).
# Brukes i salgs-e-postene.
LANDINGSSIDE_URL=https://ditt-brukernavn.github.io/byggesaksradar/

# --- E-post / SMTP (varsling + utsending) ----------------------------------
# Gmail: skru på 2-faktor og lag et "app-passord" (16 tegn) - IKKE ditt vanlige passord.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_BRUKER=din@gmail.com
SMTP_PASSORD=xxxxxxxxxxxxxxxx
SMTP_FRA=din@gmail.com
VARSEL_TIL=din@gmail.com

# Avsender fremstår alltid som SELSKAPET. Visningsnavn på e-postene (mottaker ser dette):
AVSENDER_NAVN=Byggeradar
# Signatur nederst i salgs-e-postene (valgfri). Bruk KUN selskapsinfo (f.eks. telefon,
# nettside) - aldri et privat personnavn, siden e-postene skal representere selskapet.
AVSENDER_SIGNATUR=

# E-post som "Meld meg på"-knappen på den statiske Byggeradar-siden peker til.
# Faller tilbake til VARSEL_TIL/SMTP_FRA hvis tom.
KONTAKT_EPOST=
